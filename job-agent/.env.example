# Required - the agent will not run without it.
# Get one at console.anthropic.com, or run `ant auth login` and skip this.
ANTHROPIC_API_KEY=

# Optional - free tier at developer.adzuna.com. Without these, the adzuna
# source returns nothing and the agent falls back to the other sources.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
