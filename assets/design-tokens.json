        "$value": "cubic-bezier(.165,.84,.44,1)",
        "$type": "cubicBezier"
      },
      "out-expo": {
        "$value": "cubic-bezier(.19,1,.22,1)",
        "$type": "cubicBezier"
      },
      "in-out-expo": {
        "$value": "cubic-bezier(.87,0,.13,1)",
        "$type": "cubicBezier"
      },
      "in-out-cubic": {
        "$value": "cubic-bezier(.645,.045,.355,1)",
        "$type": "cubicBezier"
      }
    }
